# ==============================================================================
# InternMatch Production Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# App Settings
# ------------------------------------------------------------------------------
APP_NAME=InternMatch
APP_ENV=production
# Keep APP_DEBUG false in production!
APP_DEBUG=false
# The public URL of the application
APP_URL=https://api.yourdomain.com
# The URL for the frontend
FRONTEND_URL=https://yourdomain.com
# State domains for Sanctum cookie auth
SANCTUM_STATEFUL_DOMAINS=yourdomain.com
# Generate using: php artisan key:generate --show
APP_KEY=

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=internmatchlaravel
DB_USERNAME=internmatch_user
# Use a strong, generated password
DB_PASSWORD=your_secure_db_password

# ------------------------------------------------------------------------------
# Queue & Cache Settings
# ------------------------------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true

# ------------------------------------------------------------------------------
# AI Service Settings
# ------------------------------------------------------------------------------
AI_ENABLED=true
AI_SERVICE_URL=http://ai:8000
AI_MODEL_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a

# ------------------------------------------------------------------------------
# Mail Settings (Example: SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# NGINX / Gateway Settings
# ------------------------------------------------------------------------------
# The domain name for the NGINX configuration (used in nginx.production.conf)
DOMAIN_NAME=yourdomain.com
